{{!
    @template block_pdfexport/content

    Published resources of the PDF Export block.

    Context variables required for this template:
    * hassections - Whether there is anything to list.
    * sections - Sections with name and items (name, pdflabel, url, iconurl, pdfurl, support, isreference).
    * coursepdfurl - URL of the course PDF.

    Example context (json):
    {
        "hassections": true,
        "coursepdfurl": "https://example.com/blocks/pdfexport/download.php?courseid=2&blockid=4",
        "sections": [{
            "name": "Introduction",
            "items": [
                {"name": "Welcome", "pdflabel": "Download PDF of Welcome", "url": "https://example.com/mod/page/view.php?id=1",
                 "iconurl": "https://example.com/theme/image.php/boost/page/1/monologo",
                 "pdfurl": "https://example.com/blocks/pdfexport/download.php?courseid=2&blockid=4&cmid=1",
                 "support": "Full content", "isreference": false},
                {"name": "Simulation", "url": "https://example.com/mod/scorm/view.php?id=2",
                 "iconurl": "https://example.com/theme/image.php/boost/scorm/1/monologo",
                 "pdfurl": null, "support": "Link only", "isreference": true}
            ]
        }]
    }
}}
<div class="block_pdfexport">
{{#hassections}}
    <a class="btn btn-primary w-100 mb-3" href="{{coursepdfurl}}">{{#pix}} f/pdf, core {{/pix}}{{#str}} downloadcoursepdf, block_pdfexport {{/str}}</a>
    {{#sections}}
    <h4 class="h6 mt-2 mb-1">{{name}}</h4>
    <ul class="list-unstyled mb-2">
        {{#items}}
        <li class="mb-2">
            <img class="icon" src="{{iconurl}}" alt="" aria-hidden="true">
            {{#url}}<a href="{{url}}" title="{{#str}} openoriginal, block_pdfexport {{/str}}">{{name}}</a>{{/url}}
            {{^url}}<span>{{name}}</span>{{/url}}
            <div class="small">
                {{#pdfurl}}<a href="{{pdfurl}}" title="{{pdflabel}}" aria-label="{{pdflabel}}">{{#str}} downloadpdf, block_pdfexport {{/str}}</a>{{/pdfurl}}
                {{#isreference}}<span class="badge bg-secondary text-white">{{support}}</span>{{/isreference}}
            </div>
        </li>
        {{/items}}
    </ul>
    {{/sections}}
{{/hassections}}
{{^hassections}}
    <p>{{#str}} noresources, block_pdfexport {{/str}}</p>
{{/hassections}}
</div>
