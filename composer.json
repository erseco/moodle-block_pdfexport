{
    "name": "erseco/moodle-block_pdfexport",
    "description": "Moodle block that publishes selected course content and exports it as PDF, per resource or as a whole course.",
    "type": "moodle-plugin",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/erseco/moodle-block_pdfexport",
    "support": {
        "issues": "https://github.com/erseco/moodle-block_pdfexport/issues",
        "source": "https://github.com/erseco/moodle-block_pdfexport"
    },
    "keywords": ["moodle", "moodle-plugin", "block", "pdf", "export"],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "moodlehq/moodle-cs": "^3.4",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
