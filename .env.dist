# Copy to .env (done automatically by `make up`). Docker Compose loads it.

# alpine-moodle image tag; see https://hub.docker.com/r/erseco/alpine-moodle/tags
MOODLE_VERSION=v5.3.0
MOODLE_PORT=80
SITE_URL=http://localhost
# Set to true when MOODLE_PORT is not 80 (and use the port in SITE_URL).
REVERSEPROXY=false

# Administrator account created on first start.
TEST_USER_EMAIL=admin@example.com
TEST_USER_USERNAME=admin
TEST_USER_PASSWORD=password
